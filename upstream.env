# Official latest stable Flycast release resolved on 2026-07-18.
# Reviewed candidate for the RetroAchievements delivery: upstream v2.7,
# pinned 2026-09-20 (master's 41 newer commits reviewed; none affect the
# Linux/SDL account/proxy work, so the reviewed tag stays the pin).
FLYCAST_UPSTREAM_URL=https://github.com/flyinghead/flycast.git
FLYCAST_UPSTREAM_TAG=v2.7
FLYCAST_UPSTREAM_SHA=5aa091fde632fb332c8d8c34e280d62dc951954c
FLYCAST_SOURCE_DATE_EPOCH=1786747058

# The Leaf package version, declared here and nowhere else: build-mlp1.sh
# emits it into build-manifest.json and verify-mlp1-package.sh checks it.
# Exactly MAJOR.MINOR.PATCH with no suffix (Pak Rat accepts nothing else);
# MAJOR.MINOR follows the upstream tag, PATCH counts packaging revisions.
FLYCAST_PACKAGE_VERSION=2.7.0
