+// UMRK: the imported Leaf account's login result. Persistence and revision
+// acceptance belong to the bridge; a failure here leaves gameplay available
+// and never reactivates the previous account.
+void Achievements::clientManagedLoginCallback(int result, const char *error_message, rc_client_t *client,
+                                              void *userdata)
+{
+	Achievements *achievements = (Achievements *)rc_client_get_userdata(client);
+	if (result != RC_OK)
+	{
+		ra_account::reportLoginFailure(rc_error_str(result),
+				error_message != nullptr ? error_message : "");
+		return;
+	}
+	const rc_client_user_t *user = rc_client_get_user_info(client);
+	if (user == nullptr || user->token == nullptr)
+	{
+		ra_account::reportLoginFailure("no-user-token", "");
+		return;
+	}
+	if (!ra_account::commitLogin(user->token))
+		// Verified but not persisted: the bridge reported it and did not
+		// accept the revision.
+		return;
+	achievements->authenticationSuccess(user);
+}
