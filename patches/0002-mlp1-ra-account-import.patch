+
+bool saveKeysChecked(const std::vector<CheckedEntry>& entries)
+{
+	if (cfgPath.empty()) {
+		WARN_LOG(COMMON, "Error: no config path, cannot save %d checked entries",
+				(int)entries.size());
+		return false;
+	}
+	if (!established) {
+		// The whole file is rewritten from cfgdb, which does not hold the
+		// user's settings: saving now would replace them with these keys.
+		WARN_LOG(COMMON, "Error: the config file '%s' could not be read; not saving %d checked entries over it",
+				cfgPath.c_str(), (int)entries.size());
+		return false;
+	}
+	for (const CheckedEntry& entry : entries)
+		cfgdb.set(entry.section, entry.key, entry.value);
+
+	std::string data;
+	cfgdb.save(data);
+
+	// Plain stdio rather than hostfs: this path needs a checked flush, sync
+	// and close, which the storage abstraction does not expose. It is only
+	// ever reached from the Leaf account bridge, where the configuration
+	// directory is an ordinary filesystem path.
+	//
+	// Same directory, so the rename stays within one filesystem and either
+	// replaces the configuration whole or leaves the previous one untouched.
+	const std::string temporary = cfgPath + ".umrk-tmp";
+	FILE *file = nowide::fopen(temporary.c_str(), "wb");
+	if (file == nullptr) {
+		WARN_LOG(COMMON, "Error: Unable to open file '%s' for saving", temporary.c_str());
+		return false;
+	}
+	bool ok = fwrite(data.c_str(), 1, data.length(), file) == data.length();
+	if (ok)
+		ok = fflush(file) == 0;
+#ifndef _WIN32
+	if (ok)
+		ok = fsync(fileno(file)) == 0;
+#endif
+	if (fclose(file) != 0)
+		ok = false;
+	if (ok)
+		ok = flycast::rename(temporary.c_str(), cfgPath.c_str()) == 0;
+	if (!ok) {
+		WARN_LOG(COMMON, "Error: Failed to save the config file '%s'; the previous one is kept",
+				cfgPath.c_str());
+		flycast::unlink(temporary.c_str());
+	}
+	return ok;
+}
