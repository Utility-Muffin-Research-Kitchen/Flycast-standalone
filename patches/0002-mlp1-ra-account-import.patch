diff --git a/core/achievements/ra_account.h b/core/achievements/ra_account.h
new file mode 100644
index 00000000..e5000cf7
--- /dev/null
+++ b/core/achievements/ra_account.h
@@ -0,0 +1,213 @@
+/*
+	UMRK: standalone-ra-account-v1 consumer for Leaf / Miniloong Pocket 1.
+
+	Flycast is free software: you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation, either version 2 of the License, or
+	(at your option) any later version.
+*/
+// The Leaf launcher (Jawaka) owns the RetroAchievements account. It resolves
+// one coherent snapshot of it per launch and exports the five child-only
+// UMRK_RA_ACCOUNT_* variables to an authorized emulator after fork(). This
+// header is the consumer half of that contract: the classifier, the durable
+// marker beside emu.cfg, and the transition the two of them select.
+//
+// Everything declared here is deliberately free of Flycast dependencies so the
+// host fixture test can compile it on its own and replay the shared
+// leaf-contracts fixtures byte for byte. The Flycast-facing glue (config
+// options, rc_client login, native notifications) lives in ra_account_bridge.cpp.
+#pragma once
+#include <map>
+#include <string>
+#include <vector>
+
+namespace achievements::ra_account
+{
+
+// Byte limits, excluding NUL. The producer validates before storing; a
+// consumer re-validates because a truncated legacy value must never be
+// authenticated.
+constexpr size_t UsernameMaxBytes = 63;
+constexpr size_t PasswordMaxBytes = 127;
+// Inclusive ceiling, 2^62. A producer fails the save rather than wrapping, so
+// this is the largest revision a consumer ever sees.
+constexpr long long RevisionMax = 4611686018427387904LL;
+
+constexpr const char *ContractId = "standalone-ra-account-v1";
+constexpr const char *MarkerFileName = ".umrk-ra-account";
+
+enum class State
+{
+	Configured,
+	NeverConfigured,
+	SignedOut,
+	Invalid,
+	Unreadable,
+};
+
+enum class Handoff
+{
+	// No UMRK_RA_ACCOUNT_* variable is set at all: this launch is not
+	// described by the contract and native behavior is untouched.
+	None,
+	Valid,
+	// A partial, unsupported or self-contradictory snapshot. Never guessed at.
+	Malformed,
+};
+
+// One classified handoff. `username`/`password` are only populated for a
+// valid configured snapshot; `reasons` carries the contract's own rejection
+// identifiers and is always secret-free.
+struct Snapshot
+{
+	Handoff handoff = Handoff::None;
+	State state = State::Unreadable;
+	std::string username;
+	std::string password;
+	long long revision = 0;
+	std::vector<std::string> reasons;
+
+	bool hasReason(const std::string& reason) const;
+	// First rejection reason, or "" for a clean snapshot. For logs and the
+	// settings status line.
+	std::string primaryReason() const;
+};
+
+// Classify a raw environment. Values arrive as std::string so a fixture can
+// express bytes getenv() could never return (an embedded NUL truncates a C
+// string); the runtime collects the same map from getenv().
+Snapshot classify(const std::map<std::string, std::string>& env);
+
+// Collect the contract variables, plus the JAWAKA_CHEEVOS_* pair whose
+// presence means the producer failed to scrub RetroArch's own handoff, from
+// the process environment.
+std::map<std::string, std::string> collectEnv();
+
+// Remove every variable classify() looks at from the process environment, so
+// no helper this process spawns can read the password. Called immediately
+// after collectEnv(), before anything else runs.
+void clearEnv();
+
+// ---------------------------------------------------------------------------
+// Durable marker
+// ---------------------------------------------------------------------------
+
+// The marker records which managed revision this emulator has actually
+// committed. It never contains a password or a token: the token lives in
+// emu.cfg, exactly where Flycast's own login puts it.
+//
+// Two files cannot be replaced atomically, so the order is conservative:
+// pending is written BEFORE the credentials change, accepted only AFTER
+// authentication and a checked config save. A pending or malformed marker is
+// never proof of a reusable token.
+enum class Transition
+{
+	Pending,
+	Accepted,
+	SignedOut,
+};
+
+struct Marker
+{
+	Transition transition = Transition::Pending;
+	// The revision this transition refers to. 0 only for a sign-out that
+	// followed a never-configured handoff, which carries no revision.
+	long long revision = 0;
+	std::string account;
+};
+
+enum class MarkerStatus
+{
+	Absent,
+	Malformed,
+	Ok,
+};
+
+MarkerStatus readMarker(const std::string& path, Marker& out);
+// Same-directory temporary file, checked write/flush/fsync/close, then
+// rename. Returns false with the previous file intact.
+bool writeMarker(const std::string& path, const Marker& marker);
+
+// ---------------------------------------------------------------------------
+// Transition
+// ---------------------------------------------------------------------------
+
+enum class Action
+{
+	// No handoff and no managed state: this emulator's own account, if any,
+	// behaves exactly as upstream Flycast.
+	Unmanaged,
+	// Marker, snapshot and persisted account agree: reuse the stored token.
+	ReuseToken,
+	// Authenticate the snapshot's credentials and, only on success, persist
+	// the token and accept the revision.
+	ImportLogin,
+	// Clear the managed username/token and record the sign-out revision.
+	SignOut,
+	// Managed state exists but the current handoff cannot justify using it:
+	// no managed authentication this session, and nothing durable is erased.
+	SuppressManaged,
+	// Nothing managed is active and nothing managed needs protecting, but the
+	// launch is worth reporting (a malformed handoff, or a sign-out this
+	// emulator already committed). Native behavior is untouched, exactly as
+	// for Unmanaged.
+	Idle,
+};
+
+struct Decision
+{
+	Action action = Action::Unmanaged;
+	long long revision = 0;
+	std::string account;
+	// Secret-free identifier for logs and the settings status line.
+	std::string reason;
+};
+
+// Select the transition from the classified snapshot, the marker on disk and
+// what Flycast itself has persisted. Pure: the caller performs the writes.
+Decision decide(const Snapshot& snapshot, MarkerStatus markerStatus,
+		const Marker& marker, const std::string& persistedAccount,
+		bool persistedTokenPresent);
+
+// ---------------------------------------------------------------------------
+// Flycast-facing entry points (ra_account_bridge.cpp)
+// ---------------------------------------------------------------------------
+
+// Consume the handoff: classify, scrub the environment, pick the transition
+// and perform its durable part. Called once from flycast_init(), after the
+// configuration is loaded and before anything can start the achievement
+// client. Never blocks on the network.
+void import();
+
+// The three calls below are the achievement client's half of the import and
+// are only meaningful in a USE_RACHIEVEMENTS build.
+//
+// One-shot: hand the imported credentials to the native password login. The
+// bridge forgets the password as it answers.
+bool takePendingLogin(std::string& username, std::string& password);
+// One-shot: the contract's single native password retry after a stored token
+// is rejected or expires. Answers once per session, so it can never loop.
+bool takeTokenRetry(std::string& username, std::string& password);
+// False when a stored token must not be used this session (a suppressed
+// handoff, a sign-out, or an import whose login has not succeeded yet).
+bool isTokenLoginAllowed();
+// Persist a verified token and accept its revision. Returns false when the
+// configuration could not be saved, in which case nothing was accepted and
+// the failure has already been reported.
+bool commitLogin(const std::string& token);
+// Report a failed managed authentication: gameplay continues without
+// achievements, and the previous account is never reused.
+void reportLoginFailure(const std::string& reason, const std::string& detail);
+
+// True when this session is running a managed account.
+bool isManaged();
+// True when a managed account is configured but must not authenticate this
+// session (suppressed handoff, or a failed marker/config write).
+bool isSuppressed();
+// Secret-free one-line status for the native settings screen; "" when there
+// is nothing managed to report.
+std::string statusLine();
+// Managed username, or "" when unmanaged.
+std::string managedAccount();
+
+} // namespace achievements::ra_account
diff --git a/core/achievements/ra_account_bridge.cpp b/core/achievements/ra_account_bridge.cpp
new file mode 100644
index 00000000..5a682748
--- /dev/null
+++ b/core/achievements/ra_account_bridge.cpp
@@ -0,0 +1,439 @@
+/*
+	UMRK: standalone-ra-account-v1 bridge between Leaf and Flycast's own
+	RetroAchievements account.
+
+	Flycast is free software: you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation, either version 2 of the License, or
+	(at your option) any later version.
+*/
+// The launcher (Jawaka) owns the account; this file makes Flycast a consumer
+// of it without adding a second login screen, a credential daemon or a shared
+// token store. It reuses Flycast's own rcheevos password login, its own
+// emu.cfg token field and its own notifications.
+//
+// The durable state is two files that cannot be replaced together, so the
+// order is conservative:
+//
+//   1. import(), before any credential changes: write the marker as pending
+//      for the incoming revision and stop reusing the old token in memory.
+//   2. the native password login completes.
+//   3. commitLogin(): checked emu.cfg save of username + token, then the
+//      marker becomes accepted.
+//
+// A crash anywhere in between leaves a pending marker, which is never proof
+// of a reusable token: the next launch simply imports again. Nothing here
+// writes a password or token to a log, to argv or to the marker.
+#include "ra_account.h"
+
+#ifdef USE_RACHIEVEMENTS
+#include "types.h"
+#include "cfg/cfg.h"
+#include "cfg/option.h"
+#include "oslib/oslib.h"
+#include "oslib/i18n.h"
+#include "stdclass.h"
+#include "ui/gui_achievements.h"
+
+#include <mutex>
+
+namespace achievements::ra_account
+{
+
+namespace
+{
+
+struct Bridge
+{
+	std::mutex mutex;
+	bool imported = false;
+	bool managed = false;
+	bool suppressed = false;
+	// One pending password login, handed to rc_client exactly once.
+	bool pendingLogin = false;
+	// One token-rejection retry, answered exactly once. Never a loop.
+	bool tokenRetryAvailable = false;
+	bool tokenLoginAllowed = true;
+	std::string account;
+	std::string password;
+	long long revision = 0;
+	std::string markerPath;
+	std::string status;
+};
+
+Bridge& bridge()
+{
+	static Bridge instance;
+	return instance;
+}
+
+// Overwrite before releasing: the password should not outlive its single use
+// in a freed allocation.
+void wipe(std::string& secret)
+{
+	if (!secret.empty())
+		memset(&secret[0], 0, secret.size());
+	secret.clear();
+	secret.shrink_to_fit();
+}
+
+void setStatus(Bridge& b, const std::string& status) {
+	b.status = status;
+}
+
+// Both surfaces, deliberately. The achievement notifier can be missed while
+// the native menu is open, and the plan requires account failures to be
+// visible without relying on logs or optional achievement toasts.
+void report(const std::string& text, const std::string& detail = {})
+{
+	WARN_LOG(COMMON, "RA account: %s%s%s", text.c_str(),
+			detail.empty() ? "" : " - ", detail.c_str());
+	os_notify(text.c_str(), 5000, detail.empty() ? nullptr : detail.c_str());
+	notifier.notify(Notification::Error, "", text, detail);
+}
+
+std::string markerPath() {
+	return get_writable_config_path(MarkerFileName);
+}
+
+bool hostOverrideConfigured() {
+	return !config::AchievementsHostUrl.get().empty();
+}
+
+} // namespace
+
+void import()
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	if (b.imported)
+		return;
+	b.imported = true;
+
+	// Copy and scrub first, whatever the verdict turns out to be: nothing this
+	// process spawns afterwards can read the password out of its environment.
+	const std::map<std::string, std::string> env = collectEnv();
+	clearEnv();
+
+	if (get_writable_config_path("").empty()) {
+		// No configuration directory (onboarding): there is nowhere to put a
+		// marker or a token, so the snapshot is dropped rather than half-used.
+		WARN_LOG(COMMON, "RA account: no config directory, the Leaf account is not imported");
+		return;
+	}
+
+	const Snapshot snapshot = classify(env);
+	b.markerPath = markerPath();
+
+	Marker marker;
+	const MarkerStatus markerStatus = readMarker(b.markerPath, marker);
+	const Decision decision = decide(snapshot, markerStatus, marker,
+			config::AchievementsUserName.get(),
+			!config::AchievementsToken.get().empty());
+
+	if (snapshot.hasReason("stale-retroarch-credentials"))
+		// The producer failed to scrub RetroArch's own handoff. Report it:
+		// silently ignoring it would hide a real isolation bug.
+		WARN_LOG(COMMON, "RA account: RetroArch credential variables leaked into this launch");
+
+	if (!config::isEstablished()
+			&& decision.action != Action::Unmanaged && decision.action != Action::Idle)
+	{
+		// emu.cfg exists but could not be read: the effective settings, the
+		// persisted account and its token are all unknown. Write nothing (not
+		// even the marker) and authenticate nothing; the next launch that
+		// can read the file decides again.
+		b.managed = true;
+		b.suppressed = true;
+		b.tokenLoginAllowed = false;
+		setStatus(b, "config-unreadable");
+		report(i18n::Ts("RetroAchievements: the Flycast settings could not be read"),
+				decision.reason);
+		return;
+	}
+
+	switch (decision.action)
+	{
+	case Action::Unmanaged:
+		NOTICE_LOG(COMMON, "RA account: unmanaged launch (%s)", decision.reason.c_str());
+		return;
+
+	case Action::Idle:
+		NOTICE_LOG(COMMON, "RA account: nothing to import (%s)", decision.reason.c_str());
+		if (snapshot.handoff == Handoff::Malformed) {
+			setStatus(b, "handoff-" + decision.reason);
+			report(i18n::Ts("RetroAchievements: the Leaf account handoff was not usable"),
+					decision.reason);
+		}
+		return;
+
+	case Action::SuppressManaged:
+		// Managed state exists but this launch cannot justify using it.
+		// Nothing durable is erased: the account is repaired in Leaf, not here.
+		b.managed = true;
+		b.suppressed = true;
+		b.tokenLoginAllowed = false;
+		setStatus(b, decision.reason);
+		WARN_LOG(COMMON, "RA account: managed authentication suppressed (%s)",
+				decision.reason.c_str());
+		report(i18n::Ts("RetroAchievements: the Leaf account is unavailable this session"),
+				decision.reason);
+		return;
+
+	case Action::ReuseToken:
+		b.managed = true;
+		b.account = decision.account;
+		b.revision = decision.revision;
+		// Keep the password for the single retry the contract allows if the
+		// stored token turns out to be rejected or expired.
+		b.password = snapshot.password;
+		b.tokenRetryAvailable = true;
+		setStatus(b, "accepted");
+		config::EnableAchievements = true;
+		NOTICE_LOG(COMMON, "RA account: reusing the token for the imported account (revision %lld)",
+				decision.revision);
+		return;
+
+	case Action::SignOut:
+	{
+		b.managed = true;
+		b.tokenLoginAllowed = false;
+		// Clear first in memory so nothing can authenticate with the old
+		// account even if the writes below fail.
+		config::EnableAchievements = false;
+		config::AchievementsUserName = std::string();
+		config::AchievementsToken = std::string();
+		if (!config::saveKeysChecked({
+				{ "achievements", "Enabled", "no" },
+				{ "achievements", "UserName", "" },
+				{ "achievements", "Token", "" } }))
+		{
+			// Do not record the sign-out: the next launch must try again
+			// rather than believe a clear that never reached the card.
+			b.suppressed = true;
+			setStatus(b, "sign-out-save-failed");
+			report(i18n::Ts("RetroAchievements: could not clear the signed-out account"),
+					decision.reason);
+			return;
+		}
+		Marker signedOut;
+		signedOut.transition = Transition::SignedOut;
+		signedOut.revision = decision.revision;
+		if (!writeMarker(b.markerPath, signedOut)) {
+			b.suppressed = true;
+			setStatus(b, "sign-out-marker-failed");
+			report(i18n::Ts("RetroAchievements: could not record the signed-out account"),
+					decision.reason);
+			return;
+		}
+		setStatus(b, "signed-out");
+		NOTICE_LOG(COMMON, "RA account: signed out in Leaf (revision %lld)", decision.revision);
+		return;
+	}
+
+	case Action::ImportLogin:
+	{
+		b.managed = true;
+		b.account = decision.account;
+		b.revision = decision.revision;
+		b.tokenLoginAllowed = false;
+
+		if (hostOverrideConfigured()) {
+			// New or changed credentials are verified against the real
+			// RetroAchievements origin, never a custom or cached host. The
+			// proxy delivery owns the direct-bootstrap-then-switch flow; until
+			// it ships, a custom host means no managed import.
+			b.suppressed = true;
+			setStatus(b, "custom-host");
+			report(i18n::Ts("RetroAchievements: the Leaf account cannot be verified through a custom host"),
+					config::AchievementsHostUrl.get());
+			return;
+		}
+
+		Marker pending;
+		pending.transition = Transition::Pending;
+		pending.revision = decision.revision;
+		pending.account = decision.account;
+		if (!writeMarker(b.markerPath, pending)) {
+			// The old files stay exactly as they were, and this session runs
+			// without managed achievements.
+			b.suppressed = true;
+			setStatus(b, "pending-marker-failed");
+			report(i18n::Ts("RetroAchievements: could not prepare the Leaf account import"),
+					decision.reason);
+			return;
+		}
+
+		// The old token is now unusable: the marker is pending, so even a
+		// crash before acceptance cannot bring it back.
+		config::AchievementsToken = std::string();
+		config::AchievementsUserName = decision.account;
+		config::EnableAchievements = true;
+		// Persist them too. Emulator::loadGame() resets every option and
+		// reloads emu.cfg before the achievement client starts, so values
+		// held only in memory are gone by then: on a config that never
+		// enabled achievements, the import silently did nothing.
+		if (!config::saveKeysChecked({
+				{ "achievements", "Enabled", "yes" },
+				{ "achievements", "UserName", decision.account },
+				{ "achievements", "Token", "" } }))
+		{
+			b.suppressed = true;
+			setStatus(b, "pending-save-failed");
+			report(i18n::Ts("RetroAchievements: could not prepare the Leaf account import"),
+					decision.reason);
+			return;
+		}
+		b.password = snapshot.password;
+		b.pendingLogin = true;
+		setStatus(b, "pending");
+		NOTICE_LOG(COMMON, "RA account: importing the Leaf account (%s, revision %lld)",
+				decision.reason.c_str(), decision.revision);
+		return;
+	}
+	}
+}
+
+bool takePendingLogin(std::string& username, std::string& password)
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	if (!b.pendingLogin)
+		return false;
+	b.pendingLogin = false;
+	username = b.account;
+	password = b.password;
+	// The import login and the token retry are mutually exclusive: this is
+	// the first and only password attempt of the two.
+	b.tokenRetryAvailable = false;
+	wipe(b.password);
+	return true;
+}
+
+bool takeTokenRetry(std::string& username, std::string& password)
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	if (!b.tokenRetryAvailable)
+		return false;
+	b.tokenRetryAvailable = false;
+	username = b.account;
+	password = b.password;
+	wipe(b.password);
+	NOTICE_LOG(COMMON, "RA account: stored token rejected, retrying the native password login once");
+	return true;
+}
+
+bool isTokenLoginAllowed()
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	return b.tokenLoginAllowed;
+}
+
+bool commitLogin(const std::string& token)
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	if (!b.managed)
+		// An unmanaged login: upstream's own persistence applies.
+		return true;
+
+	config::AchievementsUserName = b.account;
+	config::AchievementsToken = token;
+	config::EnableAchievements = true;
+	// Only these three keys, and only in their global section: per-game
+	// choices, mappings, VMU slots and every other setting stay as they are.
+	if (!config::saveKeysChecked({
+			{ "achievements", "Enabled", "yes" },
+			{ "achievements", "UserName", b.account },
+			{ "achievements", "Token", token } }))
+	{
+		b.suppressed = true;
+		setStatus(b, "token-save-failed");
+		report(i18n::Ts("RetroAchievements: the account was verified but could not be saved"));
+		return false;
+	}
+
+	Marker accepted;
+	accepted.transition = Transition::Accepted;
+	accepted.revision = b.revision;
+	accepted.account = b.account;
+	if (!writeMarker(b.markerPath, accepted)) {
+		// Authenticated and persisted, but the revision is not accepted: the
+		// next launch imports again rather than trusting an unrecorded state.
+		setStatus(b, "accept-marker-failed");
+		report(i18n::Ts("RetroAchievements: the account will be imported again on the next launch"));
+		return true;
+	}
+	setStatus(b, "accepted");
+	wipe(b.password);
+	NOTICE_LOG(COMMON, "RA account: accepted revision %lld", b.revision);
+	return true;
+}
+
+void reportLoginFailure(const std::string& reason, const std::string& detail)
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	if (!b.managed)
+		return;
+	b.suppressed = true;
+	// Never fall back to the previous account: the marker stays pending and
+	// the in-memory token is already gone. Gameplay continues without
+	// achievements.
+	b.tokenRetryAvailable = false;
+	wipe(b.password);
+	setStatus(b, "login-failed");
+	report(i18n::Ts("RetroAchievements: could not sign in with the Leaf account"),
+			detail.empty() ? reason : detail);
+}
+
+bool isManaged()
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	return b.managed;
+}
+
+bool isSuppressed()
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	return b.suppressed;
+}
+
+std::string managedAccount()
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	return b.account;
+}
+
+std::string statusLine()
+{
+	Bridge& b = bridge();
+	std::lock_guard<std::mutex> _(b.mutex);
+	return b.status;
+}
+
