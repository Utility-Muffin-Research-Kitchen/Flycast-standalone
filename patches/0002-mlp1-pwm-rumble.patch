 #include "stdclass.h"
 #include "sdl_mappingparser.h"
 #include <cmath>
+#include <cerrno>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <unistd.h>
+
+/* ── Leaf: PWM rumble sink ──────────────────────────────────────────────────
+ * The MLP1's rumble motor is a PWM channel, not a force-feedback device, so
+ * SDL_JoystickHasRumble() is false and every path below returns early. The host
+ * daemon owns the channel -- export, period, polarity, and the strength the user
+ * chose -- and hands us ready-made duty endpoints:
+ *
+ *   RUMBLE_PWM_PATH  the duty_cycle attribute to write
+ *   RUMBLE_PWM_OFF   duty meaning "off" (polarity-dependent)
+ *   RUMBLE_PWM_MIN   duty at the weakest magnitude that still moves the motor
+ *   RUMBLE_PWM_MAX   duty at full magnitude, already capped to the user's setting
+ *
+ * We only ever write duty_cycle, so we need no knowledge of polarity or period,
+ * and MIN/MAX may run in either numeric direction. Inert unless the host set the
+ * variables, so non-Leaf builds are unaffected.
+ *
+ * Parsing is strict on purpose: a malformed value silently becoming 0 would be
+ * the worst possible default, because under an inverted channel duty 0 is FULL
+ * ON -- every "stop" would drive the motor to maximum instead. */
+namespace {
+
+int   leafPwmFd  = -1;
+long  leafPwmOff = 0, leafPwmMin = 0, leafPwmMax = 0;
+bool  leafPwmProbed = false;
+u32   leafPwmStopTime = 0;   /* 0 = not driving */
+
+bool leafPwmEnv(const char *name, long *out)
+{
+	const char *s = getenv(name);
+	if (s == nullptr || *s == '\0')
+		return false;
+	errno = 0;
+	char *end = nullptr;
+	long v = strtol(s, &end, 10);
+	if (errno != 0 || end == s || *end != '\0' || v < 0)
+		return false;
+	*out = v;
+	return true;
+}
+
+void leafPwmProbe()
+{
+	leafPwmProbed = true;
+	const char *path = getenv("RUMBLE_PWM_PATH");
+	if (path == nullptr || *path == '\0')
+		return;
+	if (!leafPwmEnv("RUMBLE_PWM_OFF", &leafPwmOff)
+		|| !leafPwmEnv("RUMBLE_PWM_MIN", &leafPwmMin)
+		|| !leafPwmEnv("RUMBLE_PWM_MAX", &leafPwmMax))
+		return;
+	/* Held open for the process: the host writes this node too (it reclaims the
+	 * motor when a game is paused or the screen blanks), so caching "what we last
+	 * wrote" would go stale and swallow a write the game genuinely needs. An open
+	 * descriptor makes an unconditional write cheap enough to not need a cache. */
+	leafPwmFd = open(path, O_WRONLY | O_CLOEXEC);
+}
+
+/* magnitude 0..1; anything <= 0 parks the motor at the host's off duty. */
+void leafPwmSet(float magnitude)
+{
+	if (!leafPwmProbed)
+		leafPwmProbe();
+	if (leafPwmFd < 0)
+		return;
+	if (magnitude > 1.f)
+		magnitude = 1.f;
+	long duty = leafPwmOff;
+	if (magnitude > 0.f)
+		duty = leafPwmMin + (long)((double)(leafPwmMax - leafPwmMin) * magnitude);
+	char buf[24];
+	int len = snprintf(buf, sizeof(buf), "%ld", duty);
+	if (len > 0)
+		(void)!pwrite(leafPwmFd, buf, (size_t)len, 0);
+}
+
+}  // namespace
+
+/* Leaf: true once the host's RUMBLE_PWM_* contract is usable. Read by
+ * updateVibration() in gamepad_device.cpp, whose own filter would otherwise drop
+ * every effect on a pad with no force feedback -- which is every MLP1. */
+bool leafPwmActive()
+{
+	if (!leafPwmProbed)
+		leafPwmProbe();
+	return leafPwmFd >= 0;
+}
 
