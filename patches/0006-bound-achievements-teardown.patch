 void Achievements::asyncTask(std::function<void()>&& f) {
-	taskThread.run(std::move(f));
+	// UMRK: stopThreads() can abort this task's requests.
+	taskThread.run([this, f = std::move(f)]() {
+		http::CancelScope scope(&cancelRequests);
+		f();
