 }
 
 void Achievements::stopThreads() {
-	taskThread.stop();
+	// UMRK: teardown must not wait on the network. In-flight requests fail
+	// through their normal callbacks; follow-up tasks those callbacks queue
+	// are discarded (see WorkerThread::stop()). The idle thread stops first
+	// so it cannot queue new requests behind the drain.
+	cancelRequests = true;
 	idleThread.stop();
+	taskThread.stop();
+	cancelRequests = false;
 }
 
