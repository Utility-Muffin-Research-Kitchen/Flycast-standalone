+// UMRK: requests made by this thread while a scope is active stop within
+// about a second once the flag is set, including during a name lookup, and a
+// transfer that makes no progress for StallSeconds fails instead of waiting
+// forever. Other callers keep upstream behavior. Only the curl client
+// implements it.
+class CancelScope
+{
+public:
+	static constexpr long StallSeconds = 30;
+
+	explicit CancelScope(const std::atomic_bool *flag) : previous(current()) {
+		current() = flag;
+	}
+	~CancelScope() {
+		current() = previous;
+	}
+	CancelScope(const CancelScope&) = delete;
+	CancelScope& operator=(const CancelScope&) = delete;
+
+	static const std::atomic_bool *& current() {
+		static thread_local const std::atomic_bool *flag = nullptr;
+		return flag;
+	}
+
+private:
+	const std::atomic_bool *previous;
+};
