+// UMRK: Leaf session route (patch 0003) ---------------------------------
+
+void Achievements::setRouteStatus(const std::string& status)
+{
+	std::lock_guard<std::mutex> _(routeMutex);
+	routeStatus = status;
+}
+
+std::string Achievements::routeStatusLine()
+{
+	std::lock_guard<std::mutex> _(routeMutex);
+	return routeStatus;
+}
+
+bool Achievements::accountUsable()
+{
+	if (ra_account::isManaged())
+		return !ra_account::isSuppressed()
+			&& (ra_account::hasPendingLogin()
+				|| (ra_account::isTokenLoginAllowed()
+					&& !config::AchievementsUserName.get().empty()
+					&& !config::AchievementsToken.get().empty()));
+	return !config::AchievementsUserName.get().empty() && !config::AchievementsToken.get().empty();
+}
+
+// Called by the GUI once the content is mounted and its per-game settings
+// are loaded, before Event::Start. Every route except the Leaf proxy is
+// decided here without waiting.
+RoutePrep Achievements::prepareSessionRoute()
+{
+	// Event::Start (loader thread) decides first; the GUI's pre-start step
+	// then reads the same decision instead of making a second one.
+	std::lock_guard<std::mutex> _(routePrepareMutex);
+	if (routePrepared != 0)
+		return (RoutePrep)(routePrepared - 1);
+	const RoutePrep prep = decideSessionRoute();
+	routePrepared = (int)prep + 1;
+	return prep;
+}
+
+RoutePrep Achievements::decideSessionRoute()
+{
+	proxySession = false;
+	sessionLogin = SessionLogin::Idle;
+	setRouteStatus({});
+	routeResolved = false;
+	if (!routeHandoff())
+	{
+		// Not a Leaf-routed launch: upstream behavior, unchanged.
+		routeResolved = true;
+		return RoutePrep::Start;
+	}
+	ra_route::Inputs in;
+	in.intent = routeIntent;
+	in.enabled = config::EnableAchievements && !settings.naomi.slave;
+	// Effective Hardcore after the per-game load: Emulator::loadGame computes
+	// raHardcoreMode, and the per-game options may still say Hardcore.
+	in.hardcore = settings.raHardcoreMode || (in.enabled && config::AchievementsHardcoreMode);
+	in.customHost = !config::AchievementsHostUrl.get().empty();
+	in.accountUsable = accountUsable();
+	const ra_route::Decision d = ra_route::decide(in);
+	NOTICE_LOG(COMMON, "RA route: %s (%s, intent %s)", ra_route::routeName(d.route), d.reason,
+			ra_route::intentName(routeIntent));
+	if (d.customHostIgnoredForHardcore)
+		notifier.notify(Notification::Error, "", i18n::Ts("Hardcore uses RetroAchievements directly"),
+				i18n::Ts("Your custom achievements host is not used this session. It stays saved."));
+	if (d.route == ra_route::Route::ProxyCheck)
+		return RoutePrep::CheckService;
+	route = d.route;
+	if (d.route == ra_route::Route::Direct && routeIntent == ra_route::Intent::ServiceLive)
+		setRouteStatus(i18n::Ts("Signed in to RetroAchievements directly. Unlocks will not be queued."));
+	routeResolved = true;
+	return RoutePrep::Start;
+}
+
+bool Achievements::checkRouteService()
+{
+	const ra_route::Health h = ra_route::checkHealth(ra_route::kHealthAddress, ra_route::kHealthPort,
+			ra_route::kHealthPath, ra_route::kHealthBudgetMs);
+	NOTICE_LOG(COMMON, "RA route: Leaf offline service %s", ra_route::healthName(h));
+	return h == ra_route::Health::Ready;
+}
+
+void Achievements::beginProxySession()
+{
+	route = ra_route::Route::ProxyCheck;
+	proxySession = true;
+	holdGameLoad = true;
+	sessionLogin = SessionLogin::InProgress;
+	routeResolved = true;
+	setRouteStatus(i18n::Ts("Signing in through Leaf's offline service"));
+	if (!init())
+		sessionFailed(i18n::Ts("The achievement client could not start"));
+}
+
+void Achievements::playDirect()
+{
+	route = ra_route::Route::Direct;
+	proxySession = false;
+	routeResolved = true;
+	NOTICE_LOG(COMMON, "RA route: direct (play anyway)");
+	setRouteStatus(i18n::Ts("Signed in to RetroAchievements directly. Unlocks will not be queued."));
+}
+
+void Achievements::sessionFailed(const std::string& detail)
+{
+	sessionLogin = SessionLogin::Failed;
+	setRouteStatus(i18n::Ts("Achievements unavailable. Unlocks will not be queued."));
+	WARN_LOG(COMMON, "RA route: session sign-in failed: %s", detail.c_str());
+	notifier.notify(Notification::Error, "", i18n::Ts("Achievements unavailable. Unlocks will not be queued."), detail);
+}
+
+void Achievements::startProxyLogin()
+{
+	std::string user;
+	std::string password;
+	if (ra_account::takePendingLogin(user, password))
+	{
+		// New or changed Leaf credentials are verified against the real
+		// origin first: the proxy's login cache is keyed by username only
+		// and cannot vouch for a password.
+		rc_client_set_host(rc_client, nullptr);
+		hostOverrideActive = false;
+		rc_client_begin_login_with_password(rc_client, user.c_str(), password.c_str(),
+				clientBootstrapLoginCallback, nullptr);
+		password.assign(password.size(), '\0');
+	}
+	else if ((!ra_account::isManaged() || ra_account::isTokenLoginAllowed())
+			&& !config::AchievementsUserName.get().empty() && !config::AchievementsToken.get().empty())
+		startSessionTokenLogin();
+	else
+		sessionFailed(i18n::Ts("No usable RetroAchievements account"));
+}
+
+void Achievements::startSessionTokenLogin()
+{
+	rc_client_set_host(rc_client, ra_route::kSessionHost);
+	hostOverrideActive = true;
+	rc_client_set_hardcore_enabled(rc_client, 0);
+	rc_client_begin_login_with_token(rc_client, config::AchievementsUserName.get().c_str(),
+			config::AchievementsToken.get().c_str(), clientSessionLoginCallback, nullptr);
+}
+
+void Achievements::clientBootstrapLoginCallback(int result, const char *error_message, rc_client_t *client,
+                                                void *userdata)
+{
+	Achievements *achievements = (Achievements *)rc_client_get_userdata(client);
+	if (result != RC_OK)
+	{
+		ra_account::reportLoginFailure(rc_error_str(result), error_message != nullptr ? error_message : "");
+		achievements->sessionFailed(error_message != nullptr ? error_message : rc_error_str(result));
+		return;
+	}
+	const rc_client_user_t *user = rc_client_get_user_info(client);
+	if (user == nullptr || user->token == nullptr)
+	{
+		ra_account::reportLoginFailure("no-user-token", "");
+		achievements->sessionFailed(i18n::Ts("No user token returned"));
+		return;
+	}
+	// Persists the verified token and accepts the revision (checked save,
+	// then the accepted marker).
+	if (!ra_account::commitLogin(user->token))
+	{
+		achievements->sessionFailed(i18n::Ts("The verified account could not be saved"));
+		return;
+	}
+	// Finish this request before moving the client, and rcheevos' global
+	// host, to the session host: the move runs after this callback returns.
+	achievements->asyncTask([achievements]() {
+		rc_client_logout(achievements->rc_client);
+		achievements->startSessionTokenLogin();
+	});
+}
+
+void Achievements::clientSessionLoginCallback(int result, const char *error_message, rc_client_t *client,
+                                              void *userdata)
+{
+	Achievements *achievements = (Achievements *)rc_client_get_userdata(client);
+	if (result != RC_OK)
+	{
+		WARN_LOG(COMMON, "RA route: session login failed: %s", error_message != nullptr ? error_message : "");
+		// A rejected managed token gets its one password retry, verified
+		// directly like any new credentials.
+		std::string user;
+		std::string password;
+		if (ra_account::takeTokenRetry(user, password))
+		{
+			achievements->asyncTask([achievements, user, password]() mutable {
+				rc_client_set_host(achievements->rc_client, nullptr);
+				achievements->hostOverrideActive = false;
+				rc_client_begin_login_with_password(achievements->rc_client, user.c_str(), password.c_str(),
+						clientBootstrapLoginCallback, nullptr);
+				password.assign(password.size(), '\0');
+			});
+			return;
+		}
+		// The account stays valid; only this session is without achievements.
+		achievements->sessionFailed(error_message != nullptr ? error_message : rc_error_str(result));
+		return;
+	}
+	const rc_client_user_t *user = rc_client_get_user_info(client);
+	if (user == nullptr || user->username == nullptr)
+	{
+		achievements->sessionFailed(i18n::Ts("No user returned"));
+		return;
+	}
+	// The session must be the account Leaf accepted, never another one.
+	if (ra_account::isManaged() && strcasecmp(user->username, ra_account::managedAccount().c_str()) != 0)
+	{
+		rc_client_logout(client);
+		achievements->sessionFailed(i18n::Ts("The session signed in as a different account"));
+		return;
+	}
+	achievements->sessionLogin = SessionLogin::Ready;
+	achievements->setRouteStatus(i18n::Ts("Signed in through Leaf's offline service"));
+	achievements->authenticationSuccess(user);
+}
