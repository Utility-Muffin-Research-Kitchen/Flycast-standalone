@@ -0,0 +1,99 @@
+/*
+	UMRK: per-session RetroAchievements routing for Leaf-managed launches.
+
+	Flycast is free software: you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation, either version 2 of the License, or
+	(at your option) any later version.
+*/
+// No Flycast headers on purpose: scripts/ra-route-test.sh compiles this pair
+// on the host, so the route policy and the health check are tested as the
+// device runs them.
+#pragma once
+#include <string>
+
+namespace achievements::ra_route
+{
+
+// Private child-only handoff from Leaf's launcher: whether the supervised
+// RAOfflineProxy service may be used for this launch. It never carries a
+// URL, port or credential, and never says the game is eligible.
+constexpr const char *kEnv = "UMRK_FLYCAST_RA_ROUTE";
+
+// The only host a Leaf proxy session ever uses, and the fixed readiness
+// endpoint behind it. Neither comes from the handoff or any response.
+constexpr const char *kSessionHost = "http://127.0.0.1:8080";
+constexpr const char *kHealthAddress = "127.0.0.1";
+constexpr int kHealthPort = 8080;
+constexpr const char *kHealthPath = "/leaf/health";
+constexpr int kHealthBudgetMs = 500;
+constexpr size_t kHealthMaxResponse = 4096;
+
+enum class Intent
+{
+	Absent,       // no handoff: not a Leaf-routed launch, upstream behavior
+	Native,       // Leaf says no live service
+	ServiceLive,  // Leaf's supervised service is running or starting
+	Invalid,      // present but unrecognized: never opts into the proxy
+};
+
+Intent parseIntent(const char *value);
+// Reads the handoff once and removes it from the environment, so no helper
+// or child inherits it.
+Intent consumeHandoff();
+const char *intentName(Intent intent);
+
+enum class Route
+{
+	NoAuth,      // no authentication this session; gameplay continues
+	Direct,      // the real RetroAchievements origin
+	CustomHost,  // the user's own configured host, as upstream routes it
+	ProxyCheck,  // Leaf's proxy, once the readiness check passes
+};
+
+// The effective settings after account import and per-game loading.
+struct Inputs
+{
+	Intent intent = Intent::Absent;
+	bool settingsKnown = true;
+	bool enabled = false;
+	bool accountUsable = false;
+	bool hardcore = false;
+	bool customHost = false;
+};
+
+struct Decision
+{
+	Route route = Route::NoAuth;
+	// Hardcore always goes direct; a configured custom host is then unused
+	// for this session and the player is told so. The saved host is kept.
+	bool customHostIgnoredForHardcore = false;
+	const char *reason = "";
+};
+
+// The proxy plan's precedence table, first match wins:
+//   settings unknown -> NoAuth; disabled or no account -> NoAuth;
+//   Hardcore -> Direct; custom host -> CustomHost;
+//   intent other than ServiceLive -> Direct; otherwise ProxyCheck.
+Decision decide(const Inputs& in);
+const char *routeName(Route route);
+
+enum class Health
+{
+	Ready,
+	NotReady,     // answered, but not the ready health document
+	Unreachable,  // refused or failed before an answer
+	Timeout,      // the total budget ran out
+};
+
+// One bounded GET of kHealthPath: a single total deadline covering connect,
+// send and receive, no redirects (a 3xx is simply not ready), a capped
+// response, and no host or port taken from anything the reply says.
+Health checkHealth(const char *address, int port, const char *path, int budgetMs);
+// The acceptance rule on its own, for tests: the status line must be the
+// first line and 200, and the body must carry the service, protocol and
+// ready fields of the Leaf health document.
+bool healthResponseReady(const std::string& response);
+const char *healthName(Health health);
+
+} // namespace achievements::ra_route
