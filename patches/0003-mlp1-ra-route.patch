+#ifdef USE_RACHIEVEMENTS
+// UMRK: Leaf's offline achievements service, checked after the content is
+// loaded and before the game starts. Checking and signing in never leave a
+// blank screen: this window is up the whole time, and the player can always
+// start without waiting.
+static void gui_achievements_route()
+{
+	enum class Phase { Check, Checking, NotReady, SigningIn, Unavailable };
+	static Phase phase = Phase::Check;
+	static std::future<bool> check;
+
+	const auto startGame = []() {
+		achievements::releaseGameLoad();
+		phase = Phase::Check;
+		gui_setState(GuiState::Closed);
+	};
+
+	drawBoxartBackground();
+	centerNextWindow();
+	ImGui::SetNextWindowSize(ScaledVec2(400, 0));
+	ImGui::SetNextWindowBgAlpha(0.8f);
+	ImguiStyleVar _1(ImGuiStyleVar_WindowPadding, ScaledVec2(20, 20));
+
+	if (ImGui::Begin("##raroute", nullptr, ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_AlwaysAutoResize))
+	{
+		ImguiStyleVar _(ImGuiStyleVar_FramePadding, ScaledVec2(20, 10));
+		switch (phase)
+		{
+		case Phase::Check:
+			check = std::async(std::launch::async, achievements::checkRouteService);
+			phase = Phase::Checking;
+			[[fallthrough]];
+		case Phase::Checking:
+			ImGui::TextWrapped("%s", T("Checking Leaf's offline achievements service..."));
+			if (check.wait_for(std::chrono::milliseconds(0)) == std::future_status::ready)
+			{
+				if (check.get()) {
+					achievements::beginProxySession();
+					phase = Phase::SigningIn;
+				}
+				else
+					phase = Phase::NotReady;
+			}
+			break;
+
+		case Phase::NotReady:
+			ImGui::TextWrapped("%s", T("Leaf's offline achievements service is not ready."));
+			ImGui::Spacing();
+			ImGui::TextWrapped("%s", T("Play Anyway signs in to RetroAchievements directly. Unlocks earned while offline cannot be queued this session."));
+			ImGui::Spacing();
+			if (ImGui::Button(T("Retry")))
+				phase = Phase::Check;
+			ImGui::SameLine();
+			if (ImGui::Button(T("Cancel")))
+			{
+				phase = Phase::Check;
+				gui_stop_game();
+			}
+			ImGui::SameLine();
+			if (ImGui::Button(T("Play Anyway")))
+			{
+				achievements::playDirect();
+				startGame();
+			}
+			break;
+
+		case Phase::SigningIn:
+			ImGui::TextWrapped("%s", T("Signing in to RetroAchievements..."));
+			switch (achievements::sessionLoginState())
+			{
+			case achievements::SessionLogin::Ready:
+				startGame();
+				break;
+			case achievements::SessionLogin::Failed:
+				phase = Phase::Unavailable;
+				break;
+			default:
+				ImGui::Spacing();
+				if (ImGui::Button(T("Play Now")))
+					startGame();
+				break;
+			}
+			break;
+
+		case Phase::Unavailable:
+			ImGui::TextWrapped("%s", T("Achievements unavailable. Unlocks will not be queued."));
+			ImGui::Spacing();
+			ImGui::TextWrapped("%s", T("You can play normally. Achievements try again the next time this game starts."));
+			ImGui::Spacing();
+			if (ImGui::Button(T("Play")))
+				startGame();
+			break;
+		}
+	}
+	ImGui::End();
+}
+#endif
