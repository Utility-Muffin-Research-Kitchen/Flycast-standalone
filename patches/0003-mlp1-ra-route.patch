+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace achievements::ra_route
+{
+
+Intent parseIntent(const char *value)
+{
+	if (value == nullptr)
+		return Intent::Absent;
+	if (std::strcmp(value, "service-live") == 0)
+		return Intent::ServiceLive;
+	if (std::strcmp(value, "native") == 0)
+		return Intent::Native;
+	return Intent::Invalid;
+}
+
+Intent consumeHandoff()
+{
+	Intent intent = parseIntent(std::getenv(kEnv));
+	unsetenv(kEnv);
+	return intent;
+}
+
+const char *intentName(Intent intent)
+{
+	switch (intent)
+	{
+	case Intent::Absent: return "absent";
+	case Intent::Native: return "native";
+	case Intent::ServiceLive: return "service-live";
+	case Intent::Invalid: return "invalid";
+	}
+	return "invalid";
+}
+
+Decision decide(const Inputs& in)
+{
+	Decision d;
+	if (!in.settingsKnown) {
+		d.route = Route::NoAuth;
+		d.reason = "settings-unknown";
+		return d;
+	}
+	if (!in.enabled) {
+		d.route = Route::NoAuth;
+		d.reason = "disabled";
+		return d;
+	}
+	if (!in.accountUsable) {
+		d.route = Route::NoAuth;
+		d.reason = "no-account";
+		return d;
+	}
+	if (in.hardcore) {
+		d.route = Route::Direct;
+		d.customHostIgnoredForHardcore = in.customHost;
+		d.reason = "hardcore";
+		return d;
+	}
+	if (in.customHost) {
+		d.route = Route::CustomHost;
+		d.reason = "custom-host";
+		return d;
+	}
+	if (in.intent != Intent::ServiceLive) {
+		d.route = Route::Direct;
+		d.reason = in.intent == Intent::Native ? "service-not-live"
+				: in.intent == Intent::Invalid ? "invalid-intent" : "no-handoff";
+		return d;
+	}
+	d.route = Route::ProxyCheck;
+	d.reason = "service-live";
+	return d;
+}
+
+const char *routeName(Route route)
+{
+	switch (route)
+	{
+	case Route::NoAuth: return "none";
+	case Route::Direct: return "direct";
+	case Route::CustomHost: return "custom-host";
+	case Route::ProxyCheck: return "leaf-proxy";
+	}
+	return "none";
+}
+
+namespace {
+
+long long nowMs()
+{
+	return std::chrono::duration_cast<std::chrono::milliseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// 1 ready, 0 deadline, -1 error.
+int waitFd(int fd, short events, long long deadline)
+{
+	for (;;)
+	{
+		long long remaining = deadline - nowMs();
+		if (remaining <= 0)
+			return 0;
+		pollfd pfd{ fd, events, 0 };
+		int rc = poll(&pfd, 1, (int)remaining);
+		if (rc > 0)
+			return 1;
+		if (rc == 0)
+			return 0;
+		if (errno != EINTR)
+			return -1;
+	}
+}
+
+bool contains(const std::string& haystack, const char *needle)
+{
+	return haystack.find(needle) != std::string::npos;
+}
+
+} // namespace
+
+bool healthResponseReady(const std::string& response)
+{
+	// The status line comes first; a 200 anywhere else, or any redirect, is
+	// not an answer from the health endpoint.
+	if (response.compare(0, 13, "HTTP/1.0 200 ") != 0
+			&& response.compare(0, 13, "HTTP/1.1 200 ") != 0)
+		return false;
+	size_t body = response.find("\r\n\r\n");
+	if (body == std::string::npos)
+		return false;
+	std::string doc;
+	for (size_t i = body + 4; i < response.size(); i++)
+		if (response[i] != ' ' && response[i] != '\t' && response[i] != '\r' && response[i] != '\n')
+			doc += response[i];
+	return contains(doc, "\"service\":\"org.umrk.raofflineproxy\"")
+			&& contains(doc, "\"protocol\":\"leaf-health-1\"")
+			&& contains(doc, "\"ready\":true");
+}
+
+Health checkHealth(const char *address, int port, const char *path, int budgetMs)
+{
+	if (address == nullptr || path == nullptr || budgetMs <= 0)
+		return Health::Unreachable;
+	const long long deadline = nowMs() + budgetMs;
+
+	sockaddr_in addr{};
+	addr.sin_family = AF_INET;
+	addr.sin_port = htons((uint16_t)port);
+	if (inet_pton(AF_INET, address, &addr.sin_addr) != 1)
+		return Health::Unreachable;
+
+	int fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (fd < 0)
+		return Health::Unreachable;
+	int flags = fcntl(fd, F_GETFL, 0);
+	if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) != 0) {
+		close(fd);
+		return Health::Unreachable;
+	}
+	(void)fcntl(fd, F_SETFD, FD_CLOEXEC);
+#if defined(SO_NOSIGPIPE)
+	int one = 1;
+	(void)setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+#endif
+
+	Health result = Health::Unreachable;
+	std::string response;
+	char request[192];
+	int requestLen;
+	int w;
+	int rc = connect(fd, (sockaddr *)&addr, sizeof(addr));
+	if (rc != 0 && errno != EINPROGRESS)
+		goto out;
+	if (rc != 0)
+	{
+		w = waitFd(fd, POLLOUT, deadline);
+		if (w != 1) {
+			result = w == 0 ? Health::Timeout : Health::Unreachable;
+			goto out;
+		}
+		int soError = 0;
+		socklen_t len = sizeof(soError);
+		if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &soError, &len) != 0 || soError != 0)
+			goto out;
+	}
+
+	requestLen = std::snprintf(request, sizeof(request),
+			"GET %s HTTP/1.0\r\nHost: %s:%d\r\nConnection: close\r\n\r\n", path, address, port);
+	if (requestLen <= 0 || requestLen >= (int)sizeof(request))
+		goto out;
+	for (int sent = 0; sent < requestLen; )
+	{
+		w = waitFd(fd, POLLOUT, deadline);
+		if (w != 1) {
+			result = w == 0 ? Health::Timeout : Health::Unreachable;
+			goto out;
+		}
+#if defined(MSG_NOSIGNAL)
+		ssize_t n = send(fd, request + sent, requestLen - sent, MSG_NOSIGNAL);
+#else
+		ssize_t n = send(fd, request + sent, requestLen - sent, 0);
+#endif
+		if (n < 0) {
+			if (errno == EINTR || errno == EAGAIN)
+				continue;
+			goto out;
+		}
+		sent += (int)n;
+	}
+
+	for (;;)
+	{
+		w = waitFd(fd, POLLIN, deadline);
+		if (w != 1) {
+			result = w == 0 ? Health::Timeout : Health::Unreachable;
+			goto out;
+		}
+		char buf[1024];
+		ssize_t n = recv(fd, buf, sizeof(buf), 0);
+		if (n < 0) {
+			if (errno == EINTR || errno == EAGAIN)
+				continue;
+			goto out;
+		}
+		if (n == 0)
+			break;
+		response.append(buf, (size_t)n);
+		if (response.size() > kHealthMaxResponse) {
+			// Not the tiny health document.
+			result = Health::NotReady;
+			goto out;
+		}
+	}
+	result = healthResponseReady(response) ? Health::Ready : Health::NotReady;
+
+out:
+	close(fd);
+	return result;
+}
+
+const char *healthName(Health health)
+{
+	switch (health)
+	{
+	case Health::Ready: return "ready";
+	case Health::NotReady: return "not-ready";
+	case Health::Unreachable: return "unreachable";
+	case Health::Timeout: return "timeout";
+	}
+	return "unreachable";
+}
+
+} // namespace achievements::ra_route
