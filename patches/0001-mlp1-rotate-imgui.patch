diff --git a/core/rend/gles/opengl_driver.cpp b/core/rend/gles/opengl_driver.cpp
index 9c665f4a..1d7887fd 100644
--- a/core/rend/gles/opengl_driver.cpp
+++ b/core/rend/gles/opengl_driver.cpp
@@ -64,6 +64,35 @@ void OpenGLDriver::renderDrawData(ImDrawData* drawData, bool gui_open)
 		if (renderer != nullptr)
 			renderer->RenderLastFrame();
 	}
+	if (getenv("FLYCAST_UI_ROTATE_90") != nullptr)
+	{
+		const float logicalWidth = drawData->DisplaySize.x;
+		const ImVec2 displayPos = drawData->DisplayPos;
+		for (int listIndex = 0; listIndex < drawData->CmdListsCount; listIndex++)
+		{
+			ImDrawList *drawList = drawData->CmdLists[listIndex];
+			for (int vertexIndex = 0; vertexIndex < drawList->VtxBuffer.Size; vertexIndex++)
+			{
+				ImVec2& pos = drawList->VtxBuffer[vertexIndex].pos;
+				const float x = pos.x - displayPos.x;
+				const float y = pos.y - displayPos.y;
+				pos.x = y;
+				pos.y = logicalWidth - x;
+			}
+			for (int commandIndex = 0; commandIndex < drawList->CmdBuffer.Size; commandIndex++)
+			{
+				ImVec4& clip = drawList->CmdBuffer[commandIndex].ClipRect;
+				const float x1 = clip.x - displayPos.x;
+				const float y1 = clip.y - displayPos.y;
+				const float x2 = clip.z - displayPos.x;
+				const float y2 = clip.w - displayPos.y;
+				clip = ImVec4(y1, logicalWidth - x2,
+				              y2, logicalWidth - x1);
+			}
+		}
+		drawData->DisplayPos = ImVec2(0.f, 0.f);
+		drawData->DisplaySize = ImVec2(drawData->DisplaySize.y, logicalWidth);
+	}
 	ImGui_ImplOpenGL3_RenderDrawData(drawData);
 	if (gui_open)
 		frameRendered = true;
